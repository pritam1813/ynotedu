// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Instructor {
  id             Int                  @id @default(autoincrement())
  name           String
  image          String
  role           String
  rating         Float
  reviews        Int
  students       Int
  courses        Int
  categories     CategoryInstructor[]
  socialProfile  SocialProfile[]
  coursesCreated Course[]             @relation("InstructorCourses")
  meetings       Meeting[]            @relation("InstructorMeetings")
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
}

model SocialProfile {
  id           Int        @id @default(autoincrement())
  icon         String
  url          String
  instructorId Int
  instructor   Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)
}

model Category {
  id          Int                  @id @default(autoincrement())
  label       String               @unique
  instructors CategoryInstructor[]
  courses     Course[]             @relation("CategoryCourses")
}

model CategoryInstructor {
  category     Category   @relation(fields: [categoryId], references: [id])
  categoryId   Int
  instructor   Instructor @relation(fields: [instructorId], references: [id])
  instructorId Int

  @@id([categoryId, instructorId])
}

model Course {
  id           Int        @id @default(autoincrement())
  title        String
  description  String
  instructorId Int
  instructor   Instructor @relation("InstructorCourses", fields: [instructorId], references: [id], onDelete: Cascade)
  categoryId   Int
  category     Category   @relation("CategoryCourses", fields: [categoryId], references: [id])
  level        String
  rating       Float
  reviews      Int
  language     String
  duration     Int // duration in minutes
  price        Float
  thumbnail    String
  isPopular    Boolean    @default(false)
  isFeatured   Boolean    @default(false)
  lessons      Int
  students     Int
  meetings     Meeting[]  @relation("CourseMeetings")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Meeting {
  id            Int           @id @default(autoincrement())
  title         String
  startTime     DateTime
  duration      Int // Duration in minutes
  description   String?
  meetLink      String
  status        MeetingStatus @default(SCHEDULED)
  courseId      Int?
  course        Course?       @relation("CourseMeetings", fields: [courseId], references: [id])
  instructorId  Int
  instructor    Instructor    @relation("InstructorMeetings", fields: [instructorId], references: [id])
  googleEventId String? // Google Calendar event ID for syncing
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

enum MeetingStatus {
  SCHEDULED
  LIVE
  CANCELLED
}
