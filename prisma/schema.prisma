// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Instructor {
  id     Int    @id @default(autoincrement())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  name     String
  image    String
  role     String
  rating   Float
  reviews  Int
  students Int
  courses  Int

  categories     CategoryInstructor[]
  socialProfile  SocialProfile[]
  coursesCreated Course[]             @relation("InstructorCourses")
  meetings       Meeting[]            @relation("InstructorMeetings")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id         String       @id
  profile    UserProfile?
  instructor Instructor?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

model UserProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  firstName String?
  lastName  String?
  username  String? @unique
  bio       String?
  avatarUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SocialProfile {
  id           Int        @id @default(autoincrement())
  icon         String
  url          String
  instructorId Int
  instructor   Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)
}

model Category {
  id          Int                  @id @default(autoincrement())
  label       String               @unique
  instructors CategoryInstructor[]
  courses     Course[]             @relation("CategoryCourses")
}

model CategoryInstructor {
  category     Category   @relation(fields: [categoryId], references: [id])
  categoryId   Int
  instructor   Instructor @relation(fields: [instructorId], references: [id])
  instructorId Int

  @@id([categoryId, instructorId])
}

model Course {
  id           Int        @id @default(autoincrement())
  title        String
  description  String
  instructorId Int
  instructor   Instructor @relation("InstructorCourses", fields: [instructorId], references: [id], onDelete: Cascade)
  categoryId   Int
  category     Category   @relation("CategoryCourses", fields: [categoryId], references: [id])
  level        String
  rating       Float?     @default(0)
  reviews      Int?       @default(0)
  language     String
  duration     Int // duration in minutes
  price        Float
  thumbnail    String
  isPopular    Boolean    @default(false)
  isFeatured   Boolean    @default(false)
  lessons      Int        @default(0)
  students     Int        @default(0)
  meetings     Meeting[]  @relation("CourseMeetings")
  sections     Section[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Meeting {
  id          Int      @id @default(autoincrement())
  title       String
  startTime   DateTime
  duration    Int
  description String?
  meetLink    String

  status        MeetingStatus @default(SCHEDULED)
  courseId      Int?
  course        Course?       @relation("CourseMeetings", fields: [courseId], references: [id])
  instructorId  Int
  instructor    Instructor    @relation("InstructorMeetings", fields: [instructorId], references: [id])
  googleEventId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum MeetingStatus {
  SCHEDULED
  LIVE
  CANCELLED
}

// New models for course content

model Section {
  id          Int           @id @default(autoincrement())
  title       String
  description String?
  order       Int // For ordering sections within a course
  courseId    Int
  course      Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  contents    ContentItem[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model ContentItem {
  id          Int          @id @default(autoincrement())
  title       String
  description String?
  order       Int // For ordering content within a section
  type        ContentType
  sectionId   Int
  section     Section      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  video       Video?
  pdf         PdfDocument?
  quiz        Quiz?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

enum ContentType {
  VIDEO
  PDF
  QUIZ
}

model Video {
  id            Int         @id @default(autoincrement())
  url           String // Video URL (YouTube, Vimeo, etc.)
  duration      Int // Duration in seconds
  thumbnail     String?
  contentItemId Int         @unique
  contentItem   ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model PdfDocument {
  id            Int         @id @default(autoincrement())
  url           String // URL to the PDF file
  pages         Int?
  contentItemId Int         @unique
  contentItem   ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Quiz {
  id            Int         @id @default(autoincrement())
  timeLimit     Int? // Time limit in minutes, null means no limit
  passingScore  Int // Minimum score to pass (percentage)
  contentItemId Int         @unique
  contentItem   ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  questions     Question[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Question {
  id        Int              @id @default(autoincrement())
  text      String
  type      QuestionType
  order     Int
  points    Int              @default(1)
  quizId    Int
  quiz      Quiz             @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options   QuestionOption[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

enum QuestionType {
  MULTIPLE_CHOICE
  SINGLE_CHOICE
  TRUE_FALSE
  TEXT_ANSWER
}

model QuestionOption {
  id         Int      @id @default(autoincrement())
  text       String
  isCorrect  Boolean
  questionId Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
